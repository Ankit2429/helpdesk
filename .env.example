# Application
APP_ENV=development
LOG_LEVEL=INFO

# Local services and data paths
OLLAMA_BASE_URL=http://localhost:11434
# Ollama's published Qwen 2.5 8B-class tag is qwen2.5:7b.
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT_SECONDS=180
OLLAMA_TEMPERATURE=0.2
OLLAMA_TOP_P=0.8
OLLAMA_TOP_K=40
OLLAMA_REPEAT_PENALTY=1.1
# Lower value reduces RAM used by KV cache. 2048 works on 16GB RAM with 4GB free.
# Increase to 4096 only if your machine has 8+ GB free RAM.
OLLAMA_CONTEXT_WINDOW=2048
OLLAMA_MAX_OUTPUT_TOKENS=512
# Set to the number of physical CPU cores on your machine (not logical/HT threads).
# Ryzen 5 5600H = 6 physical cores.
OLLAMA_NUM_THREADS=6
SQLITE_DATABASE_PATH=data/helpdesk.sqlite3
KNOWLEDGE_SOURCE_PATH=data/knowledge
KNOWLEDGE_MAX_FILE_SIZE_BYTES=20000000
FAISS_INDEX_PATH=data/faiss
FAISS_ALLOW_DANGEROUS_DESERIALIZATION=false
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32
EMBEDDING_NORMALIZE=true
EMBEDDING_SHOW_PROGRESS=false
EMBEDDING_LOCAL_FILES_ONLY=true
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_CHUNK_SEPARATORS=["\n\n", "\n", " ", ""]
RAG_ADD_START_INDEX=true
RAG_SEARCH_LIMIT=4
RAG_DISTANCE_THRESHOLD=2.0

TTS_VOICE_MODEL=en_US-lessac-medium
TTS_PIPER_MODELS_DIR=data/piper
TTS_USE_CUDA=false

# Offline / Online Control
# Set to true only for development — allows Google Web API for speech recognition (requires internet).
ALLOW_ONLINE_STT_FALLBACK=false
